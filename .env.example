# This service's own HTTP port
PORT=4100

# Shared secret this service presents to zupa-api — must match
# WHATSAPP_AGENT_API_KEY on the zupa-api side.
WHATSAPP_AGENT_API_KEY=

# zupa-api base URL and the store this agent takes orders for.
ZUPA_API_BASE_URL=https://api.zupa.ng
ZUPA_STORE_ID=8a7a28dc-b54d-4841-b949-efe60dbae709

# Anthropic API key for the LLM orchestration loop.
ANTHROPIC_API_KEY=

# Where the SQLite session database file lives — must be a persistent
# volume/disk path in any deployed environment, not an ephemeral container
# filesystem, or session/cart state is lost on every redeploy.
DB_PATH=./data/agent.db

# Bank account details read into the system prompt so the agent can tell a
# customer where to transfer payment (same account the Slack bot already
# directs customers to — confirm with ops before going live).
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
