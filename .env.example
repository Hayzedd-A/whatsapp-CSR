# This service's own HTTP port
PORT=4100

# Shared secret this service presents to zupa-api — must match
# WHATSAPP_AGENT_API_KEY on the zupa-api side.
WHATSAPP_AGENT_API_KEY=

# zupa-api base URL and the store this agent takes orders for.
ZUPA_API_BASE_URL=https://api.zupa.ng
ZUPA_STORE_ID=8a7a28dc-b54d-4841-b949-efe60dbae709

# Which LLM provider runs the ordering conversation — "openai" (default,
# the primary provider system-wide) or "claude"/"anthropic" (backup). Only
# the active provider's key below is required.
AI_PROVIDER=openai

# Required when AI_PROVIDER=openai (the default).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Required when AI_PROVIDER=claude or anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Where the SQLite session database file lives — must be a persistent
# volume/disk path in any deployed environment, not an ephemeral container
# filesystem, or session/cart state is lost on every redeploy.
DB_PATH=./data/agent.db

# Bank account details read into the system prompt so the agent can tell a
# customer where to transfer payment (same account the Slack bot already
# directs customers to — confirm with ops before going live).
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=

# Optional — enables the human-facing /logs viewer (operation + error logs,
# auto-refreshing). Leave unset to disable it entirely (returns 404, not
# just unauthorized). Pick a DIFFERENT secret than WHATSAPP_AGENT_API_KEY —
# this one is typed into a browser URL and lands in browser history.
LOGS_ACCESS_KEY=

# Must match ecosystem.config.js's out_file/error_file paths — only change
# these together.
OUT_LOG_PATH=./logs/out.log
ERROR_LOG_PATH=./logs/error.log
